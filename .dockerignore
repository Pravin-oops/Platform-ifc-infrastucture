.git
.gitignore
tests/
deploy/
deployment/
README.md
# Read with `docker build -f Docker/Dockerfile`, so it never needs to be
# shipped into the context itself.
Docker/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.claude/
.venv/
venv/
*.egg-info/
.coverage
htmlcov/
.env
.idea/
.vscode/
pyproject.toml
run_tests.sh
run_tests.ps1
# Only certs/ may bring CA certificates into the build: the Dockerfile adds
# what it holds to the system trust store. Exceptions come last to win.
**/*.pem
**/*.crt
**/*.cer
!certs/*.pem
!certs/*.crt
