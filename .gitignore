__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Output of local runs (manifests, payloads, captured messages). Generated, never source.
local_out/

# .env is tracked, exactly as produce_app tracks its own: it holds locations and
# switches, never a credential. Real values go in .env.local, which is not
# tracked - and secrets go in CyberArk, which is neither.
.env.local
*.env.secret

# CA certificates (CARoot.pem) are never committed. certs/ itself is tracked so
# the folder exists in every checkout, but only its README is: drop the
# Barclays root CA in it locally and the image build picks it up (see
# Docker/Dockerfile). `certs/*`, not `certs/`, or the README could not be
# re-included.
certs/*
!certs/README.md
*.pem
*.crt
*.cer
