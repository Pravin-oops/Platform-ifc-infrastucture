IFC_APP__ENVIRONMENT=DEV
IFC_APP__LOG_LEVEL=DEBUG
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
# BAM token for bsp_python_client 1.182.1. Each BSP YAML's bam: section names the variables
# it reads: bsp_sit_config.yaml (and bsp_dev_config.yaml) -> BAM_URL_SIT / BAM_NAME_SIT,
# bsp_prod_config.yaml -> BAM_URL_PROD / BAM_NAME_PROD.
# load_dotenv(override=False) keeps any value the ECS task definition sets.
BAM_URL_SIT=https://REPLACE_WITH_SIT_BAM_HOST/authn/authenticate/sso/api
BAM_NAME_SIT=REPLACE_WITH_SIT_BAM_NAME
BAM_URL_PROD=https://REPLACE_WITH_PROD_BAM_HOST/authn/authenticate/sso/api
BAM_NAME_PROD=REPLACE_WITH_PROD_BAM_NAME
