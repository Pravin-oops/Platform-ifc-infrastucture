#######################################
# IFC trigger connector - local / developer environment.
#
# This file is for a developer shell and for docker-compose. It is NOT read by
# the application: unlike produce_app (whose CSMConfig is a pydantic-settings
# model with env_file=".env"), this connector takes its configuration from
# utility/connector_config*.yaml plus the IFC_ environment overlay, and takes
# its secrets from CSM at runtime. Source it yourself:
#
#   set -a && . ifc_trigger_connector/.env && set +a
#
# This file is TRACKED, so it must stay free of credentials: it holds locations
# and switches only. Put real values in .env.local (git-ignored), and put actual
# secrets in CSM, where the connector reads them at runtime. Never put a
# password, a token or a private key in here.
#######################################

#######################################
# Which config the entry points load
#######################################

# scripts/main.py and scripts/main_ecs.py read this when --config is absent.
APP_CONFIG_PATH=utility/connector_config.yaml

# Root that bundled resource paths (utility/schema_json.json) resolve against.
# Set in the Dockerfile to /app/ifc_trigger_connector; unset it locally and the
# app derives it from the location of utility/connector_utility.py.
# IFC_HOME=

#######################################
# IFC_ overlay
#
# Any setting in the YAML can be overridden here. A double underscore separates
# the section from the key, so IFC_KAFKA__TOPIC overrides kafka.topic. Values
# are coerced: true/false to bool, digits to int, JSON to JSON.
#######################################

IFC_APP__ENVIRONMENT=LOCAL
IFC_APP__LOG_LEVEL=DEBUG

# Reprocess a past month instead of the current one: YYYY-MM or MONTH_YYYY.
# Behaves as that month's run would have: queries business_date = the last day
# of the month before it and records the outcome against it. 2026-08 queries
# 2026-07-31. The recon check still needs a recon row from the current month,
# since upstream writes it when it runs. A month already delivered also needs
# IFC_RUN__FORCE=true. Leave unset for the scheduled monthly run.
# IFC_RUN__MONTH=2026-08

# IFC_KAFKA__TOPIC=local_ifc_tbb_kyc_refresh
# IFC_RUN__TRIGGER=TRIGGER_8
# IFC_RESILIENCE__PREFLIGHT_ENABLED=false

# DEV registry mode does not look the schema id up, so it must be pinned: the
# consumer's KafkaAvroDeserializer needs the 0x00 + schema id header on every record.
# IFC_SCHEMA_REGISTRY__MODE=DEV
# IFC_SCHEMA_REGISTRY__SCHEMA_ID=

#######################################
# AWS
#
# Every run queries the trigger's Athena table, so AWS credentials with Athena,
# Glue and S3 (table data + query results) access are always needed.
#######################################

AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
# AWS_PROFILE=

#######################################
# CSM / Vault
#
# Locations only. The system-account username and password are read from CSM at
# runtime and never appear in configuration - see utility/csm_aws_fetch.py.
#######################################

# CSM_BASE_URL=https://csm-uk1-stg.barcapint.com:8200
# CSM_MOUNT_POINT=CSM
# CSM_SECRET_PATH=intranet/static-cred/snsvc0035333_sysdevaemeammtdevops
# CSM_ROLE_NAME=snsvc0035333_aws_ecs-csm-fetcher
# CA_BUNDLE_PATH=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

#######################################
# BAM (Schema Registry token)
#
# Read by the BSP client, not by this connector. Required only when
# schema_registry.mode is SECURE, which needs kafka.bsp_config_path set.
#######################################

# BAM_URL=https://bamuat-auth.client.barclayscorp.com/authn/authenticate/sso/api
# BAM_NAME=BarclaysStreamingPlatform

#######################################
# ECS task identity
#
# Injected by the ECS agent in a real task; set them by hand only when you want
# a local run's manifest to look like a task run.
#######################################

# ECS_CLUSTER=
# ECS_TASK_ARN=
# ECS_CONTAINER_NAME=
# IMAGE_TAG=local
