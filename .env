# Local / developer settings, loaded by scripts/main*.py; variables already set win.
# Tracked: locations and switches only. Credentials go in .env.local or CyberArk, never here.

# App root for bundled resources; the Dockerfile sets it, locally it is derived.
# IFC_HOME=

# DEV | SIT | PROD: loads utility/connector_config_<env>.yaml, which names its BSP client YAML.
IFC_APP__ENVIRONMENT=DEV

# IFC_<SECTION>__<KEY> overrides any YAML setting (true/false, numbers and JSON are coerced).
IFC_APP__LOG_LEVEL=DEBUG

# Reprocess a past month (YYYY-MM); a month already delivered also needs IFC_RUN__FORCE=true.
# IFC_RUN__MONTH=2026-08

# Environments that declare the owner name's tokenisation policy; replaces the file's list.
# IFC_ENVELOPE__TOKENISED_ENVIRONMENTS=DEV,PROD

# IFC_KAFKA__TOPIC=local_ifc_tbb_kyc_refresh
# IFC_RUN__TRIGGER=TRIGGER_8
# IFC_RESILIENCE__PREFLIGHT_ENABLED=false

# DEV registry mode needs a pinned schema id: consumers require the wire-format header.
# IFC_SCHEMA_REGISTRY__MODE=DEV
# IFC_SCHEMA_REGISTRY__SCHEMA_ID=

# AWS: Athena, Glue and S3 access is needed on every run.
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
# AWS_PROFILE=

# CyberArk CCP: in ECS the product template sets CYBERARK_*. Disabled, local runs
# use BSP_USERNAME/BSP_PASSWORD from the environment.
# CYBERARK_ENABLED=false
# CYBERARK_CCP_URL=https://<ccp-host>/AIMWebService_certs/api/Accounts
# CYBERARK_APP_ID=APP_<name>
# CYBERARK_SAFE=<safe>
# CYBERARK_ACCOUNT=<account name in the safe>
# IFC_CYBERARK__CLIENT_CERT_SECRET_ID=/ifc/bsp-event-processor/cyberark/client-cert
# IFC_CYBERARK__CLIENT_KEY_SECRET_ID=/ifc/bsp-event-processor/cyberark/private-key
# CA_BUNDLE_PATH=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

# Barclays root CA secret; empty skips the read, for a local run with its own CA file.
# IFC_CA_CERTIFICATE__SECRET_ID=/ifc/bsp-event-processor/kafka/ca-bundle

# BAM token settings, read by the BSP client; needed only for the SECURE registry.
# BAM_URL=https://bamuat-auth.client.barclayscorp.com/authn/authenticate/sso/api
# BAM_NAME=BarclaysStreamingPlatform

# ECS task identity, injected by ECS; set locally only to mimic a task run's manifest.
# ECS_CLUSTER=
# ECS_TASK_ARN=
# ECS_CONTAINER_NAME=
# IMAGE_TAG=local
