IFC_APP__ENVIRONMENT=DEV
IFC_APP__LOG_LEVEL=DEBUG
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
# BAM token for bsp_python_client 1.182.1 (bam: section of the BSP YAML): PROD values.
